# Invest IQ Environment Configuration Example
# Copy to .env for local adjustments

INVEST_IQ_ENV=development
INVEST_IQ_DEBUG=true
INVEST_IQ_PORT=8000
INVEST_IQ_HOST=127.0.0.1
INVEST_IQ_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Market data provider configuration
INVEST_IQ_PROVIDER=yfinance
INVEST_IQ_CACHE_TTL_SECONDS=300
INVEST_IQ_REQUEST_TIMEOUT_SECONDS=15
